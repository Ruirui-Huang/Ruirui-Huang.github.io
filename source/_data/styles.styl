// 由 LaTeX 转换文章的排版美化
.post-body {
  // 正文链接：主题蓝 + hover 加深（默认 #555 与正文同色，可点击性弱）
  a {
    color: #3498db;
    border-bottom: 1px solid rgba(52, 152, 219, .4);

    &:hover {
      color: #217dbb;
      border-bottom-color: #217dbb;
    }
  }

  // 正文图片圆角 + 轻阴影
  img {
    border-radius: 6px;
    box-shadow: 0 2px 10px rgba(0, 0, 0, .08);
  }

  figure {
    margin: 1.2em auto;
    text-align: center;

    img {
      display: block;
      margin: 0 auto;
    }

    figcaption {
      margin-top: .5em;
      font-size: .9em;
      color: #999;
      text-align: center;
    }
  }

  // 表格悬浮表头与内边距（LaTeX tabular 转换而来）
  table {
    border-collapse: collapse;

    th, td {
      padding: .4em .8em;
    }
  }
}

// 首页文章标题 hover 变主题蓝
.posts-expand .post-title-link {
  &:hover {
    color: #3498db;
  }
}

// 文章卡片 hover 阴影加深（轻微交互反馈）
.post-block:hover {
  box-shadow: 0 4px 12px rgba(0, 0, 0, .08);
}

// 侧栏头像鼠标跟随旋转
.site-author-image {
  transition: transform .18s ease;
  will-change: transform;
}

// 标签/分类页气泡化（与侧栏词云视觉统一）
.tag-cloud-tags {
  display: flex;
  flex-wrap: wrap;
  gap: .7em;
  line-height: 1.6;

  a {
    display: inline-block;
    padding: .1em .7em;
    border-radius: 999px;
    text-decoration: none;
    background: var(--btn-default-bg);
    color: var(--text-color);
    border: 1px solid var(--border-color);
    transition: all .2s ease;

    &:hover {
      transform: scale(1.1);
      background: #3498db;
      color: #fff !important;
      border-color: #3498db;
    }
  }
}

// PDF 嵌入文章工具栏（新窗口打开/下载）
.pdf-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: .5em;
  padding: .5em .9em;
  margin-bottom: .6em;
  border: 1px solid var(--border-color);
  border-radius: 6px;
  background: var(--card-bg-color);
  font-size: .9em;

  .pdf-hint {
    color: var(--text-color);
  }

  .pdf-actions a {
    color: #3498db;
    margin-left: .8em;
    white-space: nowrap;

    &:hover {
      text-decoration: underline;
    }
  }
}

// 侧栏气泡词云
.sidebar-bubble-cloud {
  margin-top: 1.5em;
  padding-top: 1.2em;
  border-top: 1px solid var(--border-color);

  .sidebar-heading {
    font-size: .95em;
    font-weight: 600;
    margin-bottom: .8em;
    color: var(--text-color);
  }

  .bubble-tags {
    display: flex;
    flex-wrap: wrap;
    gap: .55em;
    line-height: 1.6;
  }

  .bubble-tags a {
    display: inline-block;
    padding: .1em .65em;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 1px 3px rgba(0, 0, 0, .25);
    transition: transform .2s ease, box-shadow .2s ease;

    &:hover {
      transform: scale(1.12);
      box-shadow: 0 3px 8px rgba(0, 0, 0, .3);
      color: #fff;
    }
  }
}

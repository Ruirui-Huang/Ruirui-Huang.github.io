// 由 LaTeX 转换文章的排版美化
.post-body {
  // 正文链接：主题蓝 + hover 加深（默认 #555 与正文同色，可点击性弱）
  a {
    color: #3498db;
    border-bottom: 1px solid rgba(52, 152, 219, .4);

    &:hover {
      color: #217dbb;
      border-bottom-color: #217dbb;
    }
  }

  // 正文图片圆角 + 轻阴影
  img {
    border-radius: 6px;
    box-shadow: 0 2px 10px rgba(0, 0, 0, .08);
  }

  figure {
    margin: 1.2em auto;
    text-align: center;

    img {
      display: block;
      margin: 0 auto;
    }

    figcaption {
      margin-top: .5em;
      font-size: .9em;
      color: #999;
      text-align: center;
    }
  }

  // 表格悬浮表头与内边距（LaTeX tabular 转换而来）
  table {
    border-collapse: collapse;

    th, td {
      padding: .4em .8em;
    }

    thead th {
      background: var(--table-row-odd-bg-color);
      font-weight: 600;
    }
  }

  // 标题层级：h2 加细分隔线增强结构感
  h2 {
    border-bottom: 1px solid var(--table-row-odd-bg-color);
    padding-bottom: .3em;
  }

  // h3：左侧主题蓝细竖条，增强层级
  h3 {
    padding-left: .55em;
    border-left: 3px solid #3498db;
    line-height: 1.5;
  }

  // 列表 marker 主题蓝
  li::marker {
    color: #3498db;
  }

  // 引用块：主题蓝左边框增强
  blockquote {
    border-left-color: #3498db;
  }
}

// 代码块语言标签：默认 40px 透明水印 → 右上角清晰小标签
.code-lang {
  font-size: 11px;
  line-height: 1;
  opacity: .55;
  letter-spacing: .5px;
  text-transform: uppercase;
  position: absolute;
  top: 8px;
  right: 42px;
  pointer-events: none;
}

// 代码块 tab 缩进 4（默认 8 过大，缩进更自然）
.highlight .code pre {
  tab-size: 4;
}

// 行内代码：淡蓝底 + 主题蓝字 + 圆角
.post-body code:not(.hljs):not(.language-*) {
  background: rgba(52, 152, 219, .1);
  color: #217dbb;
  padding: 2px 6px;
  border-radius: 4px;
  font-size: .9em;
}

// PDF 嵌入容器：圆角 + 加载占位底色
.post-body embed[type="application/pdf"] {
  border-radius: 8px;
  background: var(--card-bg-color);
  border: 1px solid var(--table-row-odd-bg-color);
}

// 首页文章标题 hover 变主题蓝
.posts-expand .post-title-link {
  &:hover {
    color: #3498db;
  }
}

// 文章卡片 hover 阴影加深（轻微交互反馈）
.post-block:hover {
  box-shadow: 0 4px 12px rgba(0, 0, 0, .08);
}

// 卡片与代码块圆角（视觉统一）——需与 NexT 同 specificity 才生效
.main-inner .post-block {
  border-radius: 10px;
}
.post-body .highlight {
  border-radius: 8px;
}

// 文字选中：品牌蓝底白字
::selection {
  background: #3498db;
  color: #fff;
}

// 细滚动条（WebKit）
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}
::-webkit-scrollbar-thumb {
  background: rgba(100, 100, 100, .35);
  border-radius: 4px;
  &:hover { background: rgba(100, 100, 100, .55); }
}
::-webkit-scrollbar-track {
  background: transparent;
}

// 侧栏头像鼠标跟随旋转
.site-author-image {
  transition: transform .18s ease;
  will-change: transform;
}

// 标签/分类页气泡化（与侧栏词云视觉统一）
.tag-cloud-tags {
  display: flex;
  flex-wrap: wrap;
  gap: .7em;
  line-height: 1.6;

  a {
    display: inline-block;
    padding: .1em .7em;
    border-radius: 999px;
    text-decoration: none;
    background: var(--btn-default-bg);
    color: var(--text-color);
    border: 1px solid var(--table-row-odd-bg-color);
    transition: all .2s ease;

    &:hover {
      transform: scale(1.1);
      background: #3498db;
      color: #fff !important;
      border-color: #3498db;
    }
  }
}

// PDF 嵌入文章工具栏（新窗口打开/下载）
.pdf-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: .5em;
  padding: .5em .9em;
  margin-bottom: .6em;
  border: 1px solid var(--table-row-odd-bg-color);
  border-radius: 6px;
  background: var(--card-bg-color);
  font-size: .9em;

  .pdf-hint {
    color: var(--text-color);
  }

  .pdf-actions a {
    color: #3498db;
    margin-left: .8em;
    white-space: nowrap;

    &:hover {
      text-decoration: underline;
    }
  }
}

// 侧栏气泡词云
.sidebar-bubble-cloud {
  margin-top: 1.5em;
  padding-top: 1.2em;
  border-top: 1px solid var(--table-row-odd-bg-color);

  .sidebar-heading {
    font-size: .95em;
    font-weight: 600;
    margin-bottom: .8em;
    color: var(--text-color);
  }

  .bubble-tags {
    display: flex;
    flex-wrap: wrap;
    gap: .55em;
    line-height: 1.6;
  }

  .bubble-tags a {
    display: inline-block;
    padding: .1em .65em;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 1px 3px rgba(0, 0, 0, .25);
    transition: transform .2s ease, box-shadow .2s ease;

    &:hover {
      transform: scale(1.12);
      box-shadow: 0 3px 8px rgba(0, 0, 0, .3);
      color: #fff;
    }
  }
}

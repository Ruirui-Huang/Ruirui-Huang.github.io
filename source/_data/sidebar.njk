{# 侧栏气泡词云（NexT 8 custom_file_path.sidebar 注入） #}
{% if site.tags.length %}
  <div class="sidebar-bubble-cloud">
    <div class="sidebar-heading">
      <i class="fa fa-tags fa-fw"></i> 标签词云
    </div>
    <div class="bubble-tags">
      {{ tagcloud({
        min_font: 12,
        max_font: 20,
        amount: 200,
        orderby: 'name',
        order: 1,
        color: true,
        start_color: '#e74c3c',
        end_color: '#0984e3'
      }) }}
    </div>
  </div>
  <script>
    (function () {
      function styleBubbles() {
        document.querySelectorAll('.bubble-tags a').forEach(function (a) {
          if (a.dataset.bubbled) return;
          var c = getComputedStyle(a).color;
          a.style.background = c;
          a.style.color = '#fff';
          a.dataset.bubbled = '1';
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', styleBubbles);
      } else {
        styleBubbles();
      }
    })();
  </script>
{% endif %}
<script>
  (function () {
    // 侧栏头像跟随鼠标 3D 旋转
    function initAvatarTilt() {
      var img = document.querySelector('.site-author-image');
      if (!img) return;
      var wrap = img.closest('.site-author') || img.parentElement;
      wrap.addEventListener('mousemove', function (e) {
        var r = wrap.getBoundingClientRect();
        var dx = (e.clientX - (r.left + r.width / 2)) / (r.width / 2 || 1);
        var dy = (e.clientY - (r.top + r.height / 2)) / (r.height / 2 || 1);
        img.style.transform = 'perspective(420px) rotateY(' + (dx * 18).toFixed(1) + 'deg) rotateX(' + (-dy * 18).toFixed(1) + 'deg) scale(1.05)';
      });
      wrap.addEventListener('mouseleave', function () {
        img.style.transform = '';
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAvatarTilt);
    } else {
      initAvatarTilt();
    }
  })();
</script>
<script>
  (function () {
    // 页脚访问统计数字加单位文字（不蒜子只输出数字）
    function labelBusuanzi() {
      var uv = document.getElementById('busuanzi_value_site_uv');
      var pv = document.getElementById('busuanzi_value_site_pv');
      if (uv && !uv.dataset.labelled) {
        uv.insertAdjacentText('afterend', ' 访客');
        uv.dataset.labelled = '1';
      }
      if (pv && !pv.dataset.labelled) {
        pv.insertAdjacentText('afterend', ' 次访问');
        pv.dataset.labelled = '1';
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', labelBusuanzi);
    } else {
      labelBusuanzi();
    }
  })();
</script>
<script>
  (function () {
    // 正文图片懒加载（首屏外的图延迟加载）
    function lazyImages() {
      document.querySelectorAll('.post-body img').forEach(function (img) {
        if (img.hasAttribute('loading')) return;
        img.setAttribute('loading', 'lazy');
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', lazyImages);
    } else {
      lazyImages();
    }
  })();
</script>
<script>
  (function () {
    // 正文外部链接新窗口打开（站内链接保持同窗口）
    function externalLinks() {
      var base = location.origin;
      document.querySelectorAll('.post-body a').forEach(function (a) {
        var href = a.getAttribute('href');
        if (!href || a.hasAttribute('target')) return;
        if (href.startsWith('http') && href.indexOf(base) !== 0 && href.indexOf('ruirui-huang.github.io') === -1) {
          a.setAttribute('target', '_blank');
          a.setAttribute('rel', 'noopener nofollow');
        }
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', externalLinks);
    } else {
      externalLinks();
    }
  })();
</script>
<script>
  (function () {
    // PDF 嵌入文章：自动添加"在新窗口打开 / 下载"链接
    function enhancePdfEmbeds() {
      document.querySelectorAll('embed[type="application/pdf"]').forEach(function (e) {
        if (e.dataset.enhanced) return;
        var src = e.getAttribute('src');
        if (!src) return;
        e.dataset.enhanced = '1';
        var bar = document.createElement('div');
        bar.className = 'pdf-toolbar';
        bar.innerHTML = '<span class="pdf-hint"><i class="fa fa-file-pdf-o"></i> PDF 阅读器内嵌显示</span>'
          + '<span class="pdf-actions"><a href="' + src + '" target="_blank" rel="noopener"><i class="fa fa-external-link"></i> 新窗口打开</a>'
          + ' <a href="' + src + '" download><i class="fa fa-download"></i> 下载</a></span>';
        e.parentNode.insertBefore(bar, e);
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', enhancePdfEmbeds);
    } else {
      enhancePdfEmbeds();
    }
  })();
</script>
<script>
  (function () {
    // 搜索快捷键：按 / 或 Ctrl+K 打开站内搜索弹窗
    function openSearch() {
      var trigger = document.querySelector('.menu-item-search a, a[href*="search"], .popup-trigger');
      if (trigger) {
        trigger.click();
        return true;
      }
      return false;
    }
    function onKey(e) {
      var t = e.target;
      var typing = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable);
      var k = (e.key || '').toLowerCase();
      if (e.ctrlKey && k === 'k') {
        e.preventDefault();
        openSearch();
        return;
      }
      if (e.key === '/' && !typing && !e.ctrlKey && !e.metaKey && !e.altKey) {
        e.preventDefault();
        openSearch();
      }
    }
    document.addEventListener('keydown', onKey);
  })();
</script>
